[Unit]
Description=welle-pi DAB/DAB+ receiver
Documentation=man:welle-pi(1)
# The rtl_tcp and soapysdr inputs may need the network. Wants= keeps the
# radio starting when the network never comes up.
Wants=network-online.target
After=sound.target network-online.target

[Service]
# systemd supervises welle-pi best when it stays in the foreground. welle-pi
# notices that it has no terminal and keeps playing until it is stopped.
ExecStart=/usr/bin/env welle-pi

# Run as an unprivileged user: create the account once with
#   useradd --system --shell /usr/sbin/nologin --groups audio welle-pi
# and uncomment the next two lines. No home directory is needed: settings
# come from /etc/welle-pi/welle-pi.json and the cache from CacheDirectory=
# below.
#User=welle-pi
#SupplementaryGroups=audio

# systemd creates /var/cache/welle-pi and exports it as $CACHE_DIRECTORY,
# which welle-pi uses for its station cache. Owned by the service user, so
# it also works for the unprivileged variant above without a home directory.
CacheDirectory=welle-pi

# To power the host off when the menu quits welle-pi, set "exit_command" in
# welle-pi.json, for example "systemctl poweroff". It runs with the rights
# of the service user, so the unprivileged variant needs root or a polkit
# rule. A signal, a crash or a failed input does not run it.

# Automatically restart if the binary crashes, but do not reboot/shutdown.
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
